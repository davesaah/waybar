{
  "layer": "top",
  "modules-left": [
    "sway/workspaces",
    "sway/mode",
    "sway/scratchpad",
    "sway/window"
  ],
  "modules-center": [
    "custom/media"
  ],
  "modules-right": [
    "idle_inhibitor",
    "backlight",
    "pulseaudio",
    "cpu",
    "memory",
    "battery",
    "network",
    "clock",
    "tray"
  ],
  "sway/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "format": "{icon}",
    "disable-click": true
  },
  "sway/scratchpad": {
    "format": "{icon} {count} ",
    "show-empty": false,
    "format-icons": [
      "",
      ""
    ],
    "tooltip": false
  },
  "sway/mode": {
    "format": "<span style=\"italic\">{}</span>",
		"tooltip": false
  },
  "sway/window": {
    "format": "{title}",
    "max-length": 20,
		"tooltip": false
  },
  "custom/media": {
    "format": "{}",
    "escape": true,
    "return-type": "json",
    "max-length": 65,
		"tooltip": false,
    "on-click": "playerctl play-pause",
    "on-click-right": "playerctl stop",
    "smooth-scrolling-threshold": 10,
    "on-scroll-up": "playerctl next",
    "on-scroll-down": "playerctl previous",
    "exec": "~/.config/waybar/mediaplayer/mediaplayer 2> /dev/null"
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "tooltip": false,
    "format-icons": {
      "activated": "",
      "deactivated": ""
    }
  },
  "tray": {
    "icon-size": 12,
    "spacing": 13,
		"tooltip": false
  },
  "clock": {
    "format": " {:%a %d %b    %H:%M:%S}",
    "interval": 1,
    "tooltip": false
  },
  "cpu": {
    "format": " {usage: >3}%",
		"tooltip": false
  },
  "memory": {
    "format": " {: >3}%",
		"tooltip": false
  },
  "backlight": {
    "format": "{icon}{percent: >3}%",
    "tooltip": false,
    "format-icons": [
      "󰃞 ",
      "󰃟 ",
      "󰃝 ",
      "󰃠 "
    ]
  },
  "battery": {
    "states": {
      "good": 85,
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity: >3}%",
    "format-plugged": "{capacity}% ",
    "format-charging": "{capacity}% ",
		"tooltip": false,
    "format-icons": [
      " ",
      " ",
      " ",
      " ",
      " "
    ]
  },
  "network": {
    "format": "󰤮 Disabled",
    "format-wifi": "{essid}@{ifname}: {ipaddr}/{cidr}",
    "format-ethernet": "{ifname}: {ipaddr}/{cidr}",
    "format-disconnected": "󰤮 Disconnected",
		"tooltip": false
  },
  "pulseaudio": {
    "scroll-step": 5,
    "tooltip": false,
    "format": "{icon}{volume: >3}%",
    "format-muted": "󰝟 muted",
    "format-bluetooth": "󰂱 󰋋 {volume}%",
    "format-icons": {
      "default": [
        "󰝞 ",
        " ",
        "󰕾 ",
        " "
      ]
    }
  }
}
